# Scratch run notes. Ignored rather than merely deleted: `code_version()`
# reads `git status --porcelain`, which counts untracked files, so a stray
# scratch file in the root makes every run stamp `-dirty` and become
# unpublishable.
RUN-COMMANDS.txt
run-test.txt
