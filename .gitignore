# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env
.env.local

# Data — large, regenerable, or licence-encumbered
data/repos/
data/index/
data/cache/
# Per-instance Predictions, about 7 MB per run. Ignored for the reason the
# RUN-COMMANDS.txt note below gives: `code_version()` counts untracked files,
# so an unignored directory that every run writes into would stamp every run
# `-dirty` and make it unpublishable. The first run would poison the second.
data/predictions/
*.sqlite
*.db

# OS
.DS_Store

# Session handoff  not for a public repo
HANDOFF.md

# Scratch run notes. Ignored rather than merely deleted: `code_version()`
# reads `git status --porcelain`, which counts untracked files, so a stray
# scratch file in the root makes every run stamp `-dirty` and become
# unpublishable. Run logs live outside the project entirely; this is only
# for the command crib sheet, which has to be here to be copied from.
RUN-COMMANDS.txt
